+static void streamscope_store_ref_poc(const H264Context *h,
+                                      const H264SliceContext *sl)
+{
+    H264Picture *pic = h->cur_pic_ptr;
+    int mb_xy;
+
+    if (!pic->streamscope_ref_poc)
+        return;
+
+    mb_xy = sl->mb_x + sl->mb_y * h->mb_stride;
+    memset(pic->streamscope_sub_mb_type[mb_xy], 0,
+           sizeof(pic->streamscope_sub_mb_type[mb_xy]));
+    if (IS_8X8(pic->mb_type[mb_xy]))
+        memcpy(pic->streamscope_sub_mb_type[mb_xy], sl->sub_mb_type,
+               sizeof(pic->streamscope_sub_mb_type[mb_xy]));
+    for (int list = 0; list < 2; list++) {
+        for (int part = 0; part < 4; part++) {
+            int ref = pic->ref_index[list][4 * mb_xy + part];
+            if (ref >= 0 && ref < FF_ARRAY_ELEMS(sl->ref_list[list]) &&
+                sl->ref_list[list][ref].parent)
+                pic->streamscope_ref_poc[mb_xy][list][part] =
+                    sl->ref_list[list][ref].poc;
+        }
+    }
+}
