+static void streamscope_init_hevc_block(AVVideoBlockParams *b)
+{
+    memset(b->ref_idx, -1, sizeof(b->ref_idx));
+    for (int list = 0; list < 2; list++)
+        for (int part = 0; part < 4; part++)
+            b->ref_poc[list][part] = INT32_MIN;
+}
+
+static unsigned int streamscope_hevc_part_count(uint8_t part_mode)
+{
+    if (part_mode == PART_NxN)
+        return 4;
+    return part_mode == PART_2Nx2N ? 1 : 2;
+}
+
+static void streamscope_hevc_pu_geometry(uint8_t part_mode, unsigned int part,
+                                         int x, int y, int size,
+                                         int *pu_x, int *pu_y,
+                                         int *pu_w, int *pu_h)
+{
+    *pu_x = x;
+    *pu_y = y;
+    *pu_w = size;
+    *pu_h = size;
+    switch (part_mode) {
+    case PART_2NxN:
+        *pu_y += part * size / 2;
+        *pu_h = size / 2;
+        break;
+    case PART_Nx2N:
+        *pu_x += part * size / 2;
+        *pu_w = size / 2;
+        break;
+    case PART_2NxnU:
+        *pu_y += part ? size / 4 : 0;
+        *pu_h = part ? size * 3 / 4 : size / 4;
+        break;
+    case PART_2NxnD:
+        *pu_y += part ? size * 3 / 4 : 0;
+        *pu_h = part ? size / 4 : size * 3 / 4;
+        break;
+    case PART_nLx2N:
+        *pu_x += part ? size / 4 : 0;
+        *pu_w = part ? size * 3 / 4 : size / 4;
+        break;
+    case PART_nRx2N:
+        *pu_x += part ? size * 3 / 4 : 0;
+        *pu_w = part ? size / 4 : size * 3 / 4;
+        break;
+    case PART_NxN:
+        *pu_x += (part & 1) * size / 2;
+        *pu_y += (part >> 1) * size / 2;
+        *pu_w = *pu_h = size / 2;
+        break;
+    default:
+        break;
+    }
+}
+
+static void streamscope_fill_hevc_prediction(const HEVCSPS *sps,
+                                             HEVCFrame *out,
+                                             AVVideoBlockParams *b)
+{
+    unsigned int x = FFMIN(b->src_x >> sps->log2_min_pu_size,
+                           sps->min_pu_width - 1);
+    unsigned int y = FFMIN(b->src_y >> sps->log2_min_pu_size,
+                           sps->min_pu_height - 1);
+    const MvField *mv = &out->tab_mvf[y * sps->min_pu_width + x];
+    const RefPicList *rpl = ff_hevc_get_ref_list(out, b->src_x, b->src_y);
+
+    b->prediction_flags = mv->pred_flag;
+    b->ref_idx[0][0] = mv->ref_idx[0];
+    b->ref_idx[1][0] = mv->ref_idx[1];
+    b->motion[0][0] = mv->mv[0].x;
+    b->motion[0][1] = mv->mv[0].y;
+    b->motion[1][0] = mv->mv[1].x;
+    b->motion[1][1] = mv->mv[1].y;
+    for (int list = 0; list < 2; list++) {
+        int ref = mv->ref_idx[list];
+        if (rpl && ref >= 0 && ref < rpl[list].nb_refs && rpl[list].ref[ref])
+            b->ref_poc[list][0] = rpl[list].ref[ref]->poc;
+    }
+}
+
+static int streamscope_export_hevc_blocks(HEVCContext *s, HEVCLayerContext *l,
+                                          HEVCFrame *out)
+{
+    const HEVCSPS *sps = l->sps;
+    unsigned int qp_count = sps->min_cb_width * sps->min_cb_height;
+    unsigned int mv_count = 0;
+    unsigned int ctu_count = sps->ctb_width * sps->ctb_height;
+    unsigned int cu_count = 0;
+    unsigned int pu_count = 0;
+    unsigned int tu_count = 0;
+    unsigned int block = 0;
+    AVVideoEncParams *par;
+
+    if (!(s->avctx->export_side_data & AV_CODEC_EXPORT_DATA_VIDEO_ENC_PARAMS) ||
+        s->avctx->hwaccel || !out->tab_mvf)
+        return 0;
+
+    for (unsigned int i = 0; i < sps->min_pu_width * sps->min_pu_height; i++)
+        mv_count += out->tab_mvf[i].pred_flag != 0;
+    for (unsigned int y = 0; y < sps->min_cb_height; y++) {
+        for (unsigned int x = 0; x < sps->min_cb_width; x++) {
+            unsigned int index = y * sps->min_cb_width + x;
+            unsigned int depth = l->tab_ct_depth[index];
+            unsigned int size = 1U << (sps->log2_ctb_size - depth);
+            unsigned int px = x << sps->log2_min_cb_size;
+            unsigned int py = y << sps->log2_min_cb_size;
+            if (px < sps->width && py < sps->height &&
+                !(px & (size - 1)) && !(py & (size - 1))) {
+                unsigned int parts = streamscope_hevc_part_count(l->streamscope_part_mode[index]);
+                cu_count++;
+                for (unsigned int part = 0; part < parts; part++) {
+                    int pu_x, pu_y, pu_w, pu_h;
+                    streamscope_hevc_pu_geometry(l->streamscope_part_mode[index], part,
+                                                 px, py, size,
+                                                 &pu_x, &pu_y, &pu_w, &pu_h);
+                    (void)pu_w;
+                    (void)pu_h;
+                    pu_count += pu_x < sps->width && pu_y < sps->height;
+                }
+            }
+        }
+    }
+    for (unsigned int y = 0; y < sps->min_tb_height; y++) {
+        for (unsigned int x = 0; x < sps->min_tb_width; x++) {
+            unsigned int index = y * sps->min_tb_width + x;
+            unsigned int log2_size = l->streamscope_tu_log2_size[index];
+            unsigned int size = log2_size ? 1U << log2_size : 0;
+            unsigned int px = x << sps->log2_min_tb_size;
+            unsigned int py = y << sps->log2_min_tb_size;
+            tu_count += size && px < sps->width && py < sps->height &&
+                        !(px & (size - 1)) && !(py & (size - 1));
+        }
+    }
+
+    par = av_video_enc_params_create_side_data(out->f, AV_VIDEO_ENC_PARAMS_H265,
+                                               qp_count + mv_count + ctu_count +
+                                               cu_count + pu_count + tu_count);
+    if (!par)
+        return AVERROR(ENOMEM);
+    par->qp = 0;
+
+    for (unsigned int y = 0; y < sps->min_cb_height; y++) {
+        for (unsigned int x = 0; x < sps->min_cb_width; x++) {
+            unsigned int index = y * sps->min_cb_width + x;
+            AVVideoBlockParams *b = av_video_enc_params_block(par, block++);
+            b->src_x = x << sps->log2_min_cb_size;
+            b->src_y = y << sps->log2_min_cb_size;
+            b->w = b->h = 1 << sps->log2_min_cb_size;
+            b->delta_qp = l->qp_y_tab[index];
+            b->type_flags = l->tab_ct_depth[index];
+            b->block_level = 2;
+            streamscope_init_hevc_block(b);
+        }
+    }
+
+    for (unsigned int y = 0; y < sps->min_pu_height; y++) {
+        for (unsigned int x = 0; x < sps->min_pu_width; x++) {
+            const MvField *mv = &out->tab_mvf[y * sps->min_pu_width + x];
+            AVVideoBlockParams *b;
+            if (!mv->pred_flag)
+                continue;
+            b = av_video_enc_params_block(par, block++);
+            b->src_x = x << sps->log2_min_pu_size;
+            b->src_y = y << sps->log2_min_pu_size;
+            b->w = b->h = 1 << sps->log2_min_pu_size;
+            b->block_level = 3;
+            streamscope_init_hevc_block(b);
+            streamscope_fill_hevc_prediction(sps, out, b);
+        }
+    }
